# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าได้ตามต้องการ:
#   cp .env.example .env
# ห้าม commit .env ขึ้น Git

# ---- ฐานข้อมูลสำหรับรัน task4 แบบ manual บนเครื่อง (นอก Docker) ----
DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pm25

# ---- Airflow (local development credentials) ----
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_SECRET_KEY=local-development-secret-key
# AIRFLOW_FERNET_KEY=          # ว่างไว้ก็ได้สำหรับ local

# ---- PostgreSQL ปลายทางของ task4 ใน Docker (postgres_target) ----
PM25_DB_PASSWORD=pm25-local-only

# ---- แหล่งข้อมูล PM2.5 จริงของ DAG pm25_01_air4thai_ingest ----
# openmeteo = Open-Meteo (ไม่ต้องมี key ใช้ได้ทันที, ค่าโมเดล grid)
# air4thai  = Air4Thai กรมควบคุมมลพิษ (ค่าสถานีจริง, endpoint กำลังย้ายที่อยู่)
PM25_DATA_SOURCE=openmeteo
AIR4THAI_ENDPOINT=https://air4thai.pcd.go.th/forapiV2/getAirReportV2.php
AIR4THAI_STATIONS=02t,03t,05t,08t,10t,11t,12t,13t,14t,15t,17t,19t,20t,21t,22t,23t,24t,26t,27t,50t